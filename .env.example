# ==============================================================================
# CareBridge Healthcare System - Environment Configuration Template
# Copy this file to .env and configure with your environment settings.
# ==============================================================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Connection String
# Format: postgresql://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/carebridge_db

# JWT Secret Key for Session Authentication
JWT_SECRET=replace_with_a_long_random_secure_secret_string_for_jwt_tokens

# Frontend Public API URL (Accessible by browser clients)
VITE_API_URL=http://localhost:5000/api
